<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HeartMuLa</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Allows running on machines that only have a newer runtime (e.g. .NET 10). -->
    <RollForward>Major</RollForward>
    <!-- The XML comments feed the DocFX API reference (docs/) and the editor's tooltips; CS1591 reports a public member without one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeartMuLa.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed API; the native backend comes from Directory.Build.props -->
    <PackageReference Include="TorchSharp" Version="$(TorchSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MusicGenCoreDir)/src/MusicGen.Core/MusicGen.Core.csproj" />
  </ItemGroup>

</Project>
