<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HeartMuLa.Server</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Allows running on machines that only have a newer runtime (e.g. .NET 10). -->
    <RollForward>Major</RollForward>
    <!-- The XML comments of the request/response records become the descriptions in the OpenAPI document, and feed the DocFX API reference (docs/). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeartMuLa.Net\HeartMuLa.Net.csproj" />
  </ItemGroup>

</Project>
